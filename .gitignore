# Rust 构建产物
/target/
**/*.rs.bk
*.pdb

# 安装包暂存目录里的构建产物（CI 打包时自动复制）
installer/staging/wren-app.exe

# WiX 工具集（40MB，从 NuGet 下载，不需提交）
/.wix-tools/

# WiX 编译中间产物
installer/*.wixobj
installer/*.wixpdb
installer/_verify/
installer/verify.msi

# MSI：构建中间产物不入库，但 releases/ 下的正式发布包保留供直接下载
/*.msi
installer/*.msi
!releases/*.msi

# 工作区内部记忆（不应提交到公开仓库）
/.workbuddy/

# 测试/临时文件
*.log
.DS_Store

# 最终构建用的独立 target 目录
/target-final/
